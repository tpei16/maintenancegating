{
  "design": "The 141 verdicts of the held-out maps (double nesting, risk percentile within campus and quarter, capped transfer gate) recomputed with the functions of 45_certification_corrected.py and read against the units that the routing rule flags on the held-out campus; the pooled gate quantities recomputed on a percentile scale; and the verdicts under other resolutions of ties at a top-decile boundary, for the screening model and for the prior-year count rule.",
  "definitions": {
    "flag": "unit with risk percentile R >= 0.90, R the percentile of the f^(-c) score within campus and quarter over all building systems (R_quarter), as in route() of script 45",
    "precision_flags": "share of flagged units of the system on the held-out campus that have a high-burden next quarter",
    "base_rate": "share of all units of the system on the held-out campus with a high-burden next quarter",
    "route_lift": "precision_flags / base_rate",
    "route_evaluable": "at least 30 flagged units, at least 10 high-burden quarters and at least 100 units of the system on the held-out campus; fixed before any outcome was read",
    "bootstrap": "1000 resamples of the buildings of the campus that hold units of the system, with replacement, R and flags held at their stored values; 95% percentile interval; seed [42, pair index]",
    "heldout_lift": "top-decile lift of f^(-c) within the system on campus c (raw score, ties in stored order), as in fold_gate_verdicts.csv",
    "system_percentile": "percentile of the score within campus, quarter and building system",
    "campus_percentile_R": "the campus-wide risk percentile R",
    "scale_variant": "the pooled top-decile lift and the risk-gradient bands read the stated percentile instead of the raw score; per-campus lifts, data sufficiency and prior-record trace as stored; S by sufficiency() of script 45",
    "tie_straddles": "more units share the boundary score of the top decile than the decile has room for after the units scoring above it, so the stored record order decides which of them enter",
    "random_tie_breaking": "rows of every map put in random order before the gates are computed, 200 repetitions, seeds [42, r]",
    "fractional_inclusion": "tied units at the boundary enter the top decile with equal fractional weight (expected precision under random tie-breaking)",
    "extreme_resolutions": "tied units taken non-high-burden first (low) and high-burden first (high); S is non-decreasing in every lift, so a verdict equal at both extremes is the same under any resolution of the ties",
    "count_rule": "rule_upm_count_prevyear: prior-year reactive work-order count as the risk score, maps built as in scripts 48 and 59"
  },
