{
  "design": "Uncertainty of the held-out comparisons with campus-system pairs clustered by campus and by building system: two-way (pigeonhole) and one-way cluster bootstraps, a permutation of the verdicts of whole building systems, and the pair-level intervals beside them; from the stored tables, no model.",
  "definitions": {
    "two_way_cluster": "campuses and building systems present among the analysed pairs resampled independently with replacement; pair (c, k) enters with multiplicity a_c x b_k",
    "campus_cluster": "campuses resampled with replacement; pair (c, k) enters a_c times",
    "system_cluster": "building systems resampled with replacement; pair (c, k) enters b_k times",
    "pair_level": "pairs resampled with replacement as if independent",
    "bootstrap": "5000 replicates per scheme, 95% percentile interval, seeds [42, test, scheme]",
    "undefined_replicate": "a replicate in which the supported or the not supported group receives no pair, or a correlation has a constant argument; counted and left out of the interval",
    "system_block_permutation": "10000 random permutations pi of the building systems analysed; pair (c, k) takes the verdict and S of pair (c, pi(k)) in the stored verdict table; a pair whose source has no verdict is left out of that permutation; two-sided p = (1 + #|T*| >= |T|) / (1 + permutations)",
    "two_fold": "lift of at least 2",
    "held_out_check": "95 pairs evaluable on the held-out campus, fold_gate_verdicts.csv",
    "count_based_rule": "simple_rule_prespecified of fold_gate_verdicts.csv on the same 95 pairs",
    "forward_test": "pairs evaluable in 2017 to 2019 with a peer verdict from records dated 2016 or earlier, local_history_baseline.csv (cert_peer, S_peer, lift_eval_model)",
    "naive_newcombe95": "Newcombe hybrid score interval from the two Wilson intervals",
    "naive_fisher_z95": "Fisher z interval with the Bonett-Wright standard error"
  },
  "reference_check": {
    "held_out_check": "74/77 and 14/18, Spearman 0.2628 (p 0.0101)",
    "count_based_rule": "78/83 and 10/12",
    "forward_test": "54/61 and 24/27, 3 pairs without a peer verdict",
    "matches_stored_tables": true
  },
