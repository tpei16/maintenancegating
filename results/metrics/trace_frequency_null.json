{
  "design": "Per stratum with at least 30 extreme events on the pooled panel, the no-antecedent share of extreme events (script 45's prior-record-trace quantity) beside frequency-matched references: the same no-reactive-work share among reactive cell-quarters with four quarters of history, and among all cell-quarters with history, both weighted to the campus mix of the events; intervals resample buildings within campuses.",
  "definitions": {
    "extreme_event": "cell-quarter with reactive labour above the system's 90th percentile of positive reactive labour (pooled panel), with four quarters of cell history",
    "no_antecedent": "no reactive work order on the cell in the preceding four quarters",
    "no_antecedent_counting_pm": "no reactive and no preventive work order in the preceding four quarters",
    "reference_active": "share with no reactive work order in the preceding four quarters among cell-quarters of the stratum with at least one reactive work order and four quarters of history (extreme events included), per campus, weighted by the campus shares of the extreme events",
    "reference_active_excluding_events": "reference_active with the extreme events left out",
    "reference_all": "the same share over all cell-quarters with four quarters of history",
    "record_start_campus": "events dropped when period_q < first panel quarter of the campus + q; the 4-quarter version removes nothing because events already need four quarters of cell history",
    "record_start_cell": "events dropped when period_q < the cell's first quarter + q",
    "verdict": "pass < 0.10, caution < 0.25, fail otherwise; caution below 30 events",
    "bootstrap": "1000 replicates; buildings resampled with replacement within each campus; campus weights recomputed per replicate; percentile 95% intervals",
    "mean_reactive_wo_per_cell_quarter": "mean upm_count over every cell-quarter of the stratum"
  },
